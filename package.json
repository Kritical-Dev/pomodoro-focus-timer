{
  "name": "pomodoro",
  "version": "2.1.0",
  "description": "A modern, fully self-contained Pomodoro userscript that floats on every website and tracks how long you spend on tasks each day. No dependencies at runtime or build time; the UI lives in a Shadow DOM so page styles never leak in or out.",
  "main": "pomodoro.user.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kritical-Dev/pomodoro-focus-timer.git"
  },
  "homepage": "https://github.com/Kritical-Dev/pomodoro-focus-timer",
  "bugs": {
    "url": "https://github.com/Kritical-Dev/pomodoro-focus-timer/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint .",
    "test": "node --test test/core.test.mjs && node test/run.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.mjs",
    "test:all": "npm run lint && npm test && npm run test:e2e"
  },
  "keywords": [
    "pomodoro",
    "tampermonkey",
    "userscript",
    "timer"
  ],
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.65.0"
  }
}
